MPESA_ENV=production
PUBLIC_ORIGIN=https://YOUR_PUBLIC_DOMAIN
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://YOUR_PUBLIC_DOMAIN/api/payments/mpesa/callback

# Generate each key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TICKET_ENCRYPTION_KEY=
TICKET_LOOKUP_HMAC_KEY=

# Resend transactional email: use a verified sending domain/address.
RESEND_API_KEY=
TICKET_EMAIL_FROM=Talanta Stadium <tickets@YOUR_VERIFIED_DOMAIN>
TICKET_EMAIL_REPLY_TO=talantastadi@gmail.com

# M-Pesa B2C disbursements: encrypted initiator credential from the Daraja portal.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a separate value from both ticket keys; never reuse a Daraja credential.
MPESA_B2C_CALLBACK_TOKEN=
